{
  // Type CHECKING only — nothing here takes part in the build. Vite never reads this file and
  // strips JSDoc with every other comment, so the bundle is byte-for-byte what it was without it.
  // A file opts in with `// @ts-check` on its first line; `checkJs` stays off so an unmarked file
  // is never reported. Hub journal: 2026-10-12-code-quality.md (stage 1 — types).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/core/shared/roster.types.js",
    "src/composables/gameClock.js",
    "src/data/data.types.js",
    "src/core/roster/rosterEngine.js",
    "src/core/roster/rosterEnhEligible.js",
    "src/core/roster/rosterValidation.js",
    "src/composables/rosterModifiers.js",
    "src/core/roster/rosterExport.js",
    "src/composables/rosterStatMods.js",
    "src/composables/rosterHold.js",
    "src/composables/rosterSummary.js",
    "src/core/roster/rosterLimit.js",
    "src/composables/rosterHandoff.js",
    "src/composables/rosterGameContext.js",
    "src/core/roster/rosterImport.js",
    "src/composables/rosterUnitCard.js",
    "src/composables/useDatasheetsRu.js",
    "src/utils/debouncedSave.js",
    "src/utils/sanitizeHtml.js",
    "src/directives/safeHtml.js"
  ]
}
