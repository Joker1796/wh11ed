# The new tracker's beta on beta.wh-rules.ru — copy to .env.deploy.beta (gitignored) and fill in the
# CDN id. Deploy from the tracker branch, AFTER the site's release (it merges the release first):
#   ENVFILE=.env.deploy.beta npm run deploy
# BUMP=none: the beta ships the version it merged and never commits, pushes or moves main.
# No CHANGELOG_YDB_*: the release notes archive is the site's, the beta never writes it.

BUCKET=s3://beta.wh-rules.ru
CDN_RESOURCE_ID=
BUMP=none

# Its own origin (canonical, sitemap), the site's API (login comes back here: ?return=), and the
# beta switch — noindex, robots Disallow, the app named "WH Rules Beta", the beta banner.
VITE_SITE_ORIGIN=https://beta.wh-rules.ru
VITE_API_BASE_URL=https://api.wh-rules.ru
VITE_BETA=1
