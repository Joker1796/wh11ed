# Frontend build-time config. Copy to .env.local for dev, or pass inline at build time.
# Vite exposes only VITE_*-prefixed vars to the client.

# Base URL of the wh11ed-api backend.
#   dev:  http://localhost:8787   (local `npm run dev` in ../wh11ed-api)
#   prod: https://api.wh11ed.ru
VITE_API_BASE_URL=http://localhost:8787
