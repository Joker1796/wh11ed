# Frontend build-time config. Copy to .env.local for dev, or pass inline at build time.
# Vite exposes only VITE_*-prefixed vars to the client.

# Base URL of the wh11ed-api backend.
#   dev:  http://localhost:8787   (local `npm run dev` in ../wh11ed-api)
#   prod: https://api.wh11ed.ru   (moving to https://api.wh-rules.ru)
VITE_API_BASE_URL=http://localhost:8787

# Canonical public origin (scheme + host, no trailing slash). Defaults to https://wh11ed.ru in
# code; set here (or in deploy.sh) to flip every canonical/hreflang/og:url + sitemap URL at the
# wh11ed.ru → wh-rules.ru cutover.
# VITE_SITE_ORIGIN=https://wh-rules.ru
