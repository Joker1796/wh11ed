{
  "name": "wh-rules",
  "version": "2.2.7",
  "description": "Bilingual (EN/RU) interactive reference for Warhammer 40,000 11th Edition — core rules, the Event Companion, faction rules and unit datasheets, plus an offline game tracker. A fast, searchable Vue 3 SPA hosted at wh-rules.ru.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gen-seo-routes.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "images:webp": "node scripts/gen-webp.mjs && node scripts/gen-image-dims.mjs",
    "datasheets:index": "node scripts/gen-datasheet-index.mjs",
    "roster:data": "node scripts/gen-roster-data.mjs",
    "roster:data:check": "node scripts/gen-roster-data.mjs --check",
    "faction-rules:index": "node scripts/gen-faction-rules-index.mjs",
    "combat-patrol:index": "node scripts/gen-combat-patrol-search-index.mjs",
    "sourceids": "node scripts/gen-source-ids.mjs",
    "condkeywords": "node scripts/gen-conditional-keywords.mjs",
    "faq": "node scripts/gen-faction-faq.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:text": "node scripts/sync-faction-text.mjs",
    "sync:mfm": "node scripts/sync-mfm-points.mjs",
    "parity": "node scripts/parity-check.mjs",
    "images:dims": "node scripts/gen-image-dims.mjs",
    "icons": "node scripts/gen-pwa-icons.mjs",
    "screenshots": "node scripts/gen-pwa-screenshots.mjs",
    "splash": "node scripts/gen-ios-splash.mjs",
    "translate:queue": "node scripts/gen-translation-queue.mjs",
    "translate:check": "node scripts/gen-translation-queue.mjs --check",
    "modifiers": "node scripts/gen-roster-modifiers.mjs",
    "modifiers:check": "node scripts/gen-roster-modifiers.mjs --check",
    "modifiers:queue": "node scripts/gen-roster-modifiers.mjs --queue",
    "roster:texts-ru": "node scripts/gen-roster-texts-ru.mjs"
  },
  "keywords": [],
  "author": "Joker1796",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/sofia-sans-extra-condensed": "^5.2.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "bootstrap-icons": "^1.13.1",
    "vite": "^6.4.3",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
