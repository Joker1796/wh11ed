{
  "name": "wh-rules",
  "version": "2.10.4",
  "description": "Bilingual (EN/RU) interactive reference for Warhammer 40,000 11th Edition — core rules, the Event Companion, faction rules and unit datasheets, plus an offline game tracker. A fast, searchable Vue 3 SPA hosted at wh-rules.ru.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-chunk-graph.mjs && node scripts/gen-seo-routes.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "images:webp": "node scripts/gen-webp.mjs && node scripts/gen-image-dims.mjs",
    "datasheets:index": "node scripts/gen-datasheet-index.mjs",
    "own-abilities": "node scripts/gen-own-abilities.mjs",
    "roster:data": "node scripts/gen-roster-data.mjs && node scripts/gen-roster-texts-ru.mjs && node scripts/gen-enhancement-weapons.mjs",
    "roster:data:check": "node scripts/gen-roster-data.mjs --check && node scripts/gen-roster-texts-ru.mjs --check",
    "roster:imports": "npx vite-node scripts/check-roster-imports.mjs",
    "faction-rules:index": "node scripts/gen-faction-rules-index.mjs",
    "phases:index": "node scripts/gen-phase-index.mjs",
    "combat-patrol:index": "node scripts/gen-combat-patrol-search-index.mjs",
    "combat-patrol:missions": "node scripts/gen-combat-patrol-missions.mjs",
    "sourceids": "node scripts/gen-source-ids.mjs",
    "condkeywords": "node scripts/gen-conditional-keywords.mjs",
    "faq": "node scripts/gen-faction-faq.mjs",
    "patches": "node scripts/gen-patch-notes.mjs",
    "points:pdf": "node scripts/gen-points-pdf.mjs points-pdf ru && node scripts/gen-points-pdf.mjs points-pdf en",
    "faq:index": "node scripts/gen-faction-faq-search-index.mjs",
    "legends": "node scripts/gen-faction-legends.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:text": "node scripts/sync-faction-text.mjs",
    "sync:mfm": "node scripts/sync-mfm-points.mjs",
    "sync:baseline": "node scripts/sync-baseline-report.mjs",
    "parity": "node scripts/parity-check.mjs",
    "omissions": "node scripts/check-rule-omissions.mjs",
    "detmeta": "node scripts/check-detachment-meta.mjs",
    "wtags": "node scripts/check-weapon-abilities.mjs",
    "dsrules": "node scripts/check-datasheet-rules.mjs",
    "imgrules": "node scripts/check-image-rules.mjs",
    "ruletext": "node scripts/check-rule-text.mjs",
    "coregrants": "node scripts/check-core-grants.mjs",
    "dsids": "node scripts/check-datasheet-ids.mjs",
    "bases": "node scripts/check-bases.mjs",
    "missions": "node scripts/check-missions.mjs",
    "packs": "node scripts/check-packs.mjs",
    "pack-text": "node scripts/check-pack-text.mjs",
    "columns": "node scripts/check-appdata-columns.mjs",
    "exceptions": "node scripts/check-appdata-exceptions.mjs",
    "errata-tables": "node scripts/check-errata-tables.mjs",
    "corefaq": "node scripts/check-core-faq.mjs",
    "dsids:write": "node scripts/check-datasheet-ids.mjs --write",
    "emphasis": "node scripts/check-emphasis.mjs",
    "layouts": "node scripts/check-layout-art.mjs",
    "companions": "node scripts/check-companion-pdfs.mjs",
    "documents": "node scripts/check-documents.mjs",
    "chunks": "node scripts/check-chunk-graph.mjs",
    "radii": "node scripts/check-radii.mjs",
    "dupes": "node scripts/check-css-dupes.mjs",
    "a11y": "node scripts/check-a11y.mjs",
    "legends-tag": "node scripts/check-legends-tag.mjs",
    "weapon-table": "node scripts/check-weapon-table.mjs",
    "detachment-row": "node scripts/check-detachment-row.mjs",
    "smoke": "npx vite-node scripts/smoke.mjs",
    "perf": "npx vite-node scripts/check-perf.mjs",
    "test-rosters": "npx vite-node scripts/test-roster-links.mjs",
    "stand:seed": "npx vite-node scripts/stand-seed.mjs",
    "imghash": "node scripts/check-image-renames.mjs",
    "images:dims": "node scripts/gen-image-dims.mjs",
    "faction-icons": "node scripts/gen-faction-icons.mjs",
    "translate:queue": "node scripts/gen-translation-queue.mjs",
    "translate:check": "node scripts/gen-translation-queue.mjs --check",
    "modifiers": "node scripts/gen-roster-modifiers.mjs",
    "modifiers:check": "node scripts/gen-roster-modifiers.mjs --check",
    "modifiers:queue": "node scripts/gen-roster-modifiers.mjs --queue",
    "roster:texts-ru": "node scripts/gen-roster-texts-ru.mjs",
    "gloss": "node scripts/gloss-bold-terms.mjs"
  },
  "keywords": [],
  "author": "Joker1796",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/sofia-sans-extra-condensed": "^5.2.8",
    "@vitejs/plugin-vue": "^6.0.10",
    "qrcode": "^1.5.4",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
