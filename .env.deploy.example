# Copy to .env.deploy (gitignored) and fill in. Sourced by deploy.sh (set -a → all exported,
# so VITE_* here reach the Vite build too).
# Yandex CDN resource id, purged after each deploy. Empty → purge skipped.
CDN_RESOURCE_ID=
# Optional overrides:
# BUCKET=s3://wh11ed.ru
# AWS_PROFILE=yc

# ── wh-rules.ru cutover (set all of these together at go-live) ──────────────────
# Flips the deploy target bucket, the CDN purged, and the origin/API baked into the build.
# BUCKET=s3://wh-rules.ru
# CDN_RESOURCE_ID=bc8r6sdaw3f64oi3hbdo
# VITE_SITE_ORIGIN=https://wh-rules.ru
# VITE_API_BASE_URL=https://api.wh-rules.ru
