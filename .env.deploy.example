# Copy to .env.deploy (gitignored) and fill it in. Sourced by deploy.sh (set -a → all exported,
# so VITE_* here reach the Vite build too).
#
# One target only: wh-rules.ru. The old wh11ed.ru is frozen on its last build and is not
# redeployed — see MIGRATION.md.

# Deploy target bucket + the CDN resource purged after every upload (empty → purge skipped).
BUCKET=s3://wh-rules.ru
CDN_RESOURCE_ID=

# Baked into the build: canonical/hreflang/sitemap/robots/og origin, and the API the SPA calls.
VITE_SITE_ORIGIN=https://wh-rules.ru
VITE_API_BASE_URL=https://api.wh-rules.ru

# Optional:
# AWS_PROFILE=yc
