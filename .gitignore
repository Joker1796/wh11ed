node_modules/
dist/
.DS_Store
*.local
.idea/

# Local env (Vite + deploy). Keep the *.example templates committed.
.env
.env.*
!.env.example
!.env.deploy.example
!.env.deploy.beta.example

# Local source/reference material (not for the repo)
sources/
*.pdf
.backup/
scripts/.drafts/

# Personal appdata-sync session log (see DATA-SYNC.md) — not *.local since it needs the .md
# extension for editor syntax highlighting, so it needs its own explicit line.
SYNC-LOG.local.md

# Per-batch review scratch file for the RU datasheet aliases task (see ALIASES-PROGRESS.md) —
# overwritten every batch, not a history log, so it stays out of git like SYNC-LOG.local.md above.
ALIASES-BATCH.local.md
TRANSLATION-QUEUE.local.json
# Roster modifier review list for one appdata bump (see src/components/roster/CLAUDE.md) —
# regenerated by `npm run modifiers:queue`, same one-shot nature as the translation queue above.
# Needs its own line for the same reason that one does: the `*.local` glob doesn't match
# `*.local.json`.
MODIFIER-QUEUE.local.json

# Per-route static HTML generated by scripts/gen-seo-routes.mjs. Deliberately NOT in dist/
# (vite precaches **/*.html); deploy.sh uploads it as bucket keys.
seo-html/

# The points PDF and its HTML (npm run points:pdf) — uploaded by hand, never committed.
/points-pdf/

# The stand's seed page (npm run stand:seed) — built from the data of the day, never committed.
public/_seed.json
public/_seed.html

# The golden master's snapshots (golden/README.md): a local baseline, rebuilt from a commit on demand.
golden/__snapshots__/

# `npm run mutate` (scripts/mutate.mjs): the tool's snapshot and its worker trees.
/.metrics/
/target/
